# ============================================================================
# TaskFlow 环境变量模板
# 用法：复制为 .env（本地）或在服务器上单独维护生产 .env
# 安全约定：本文件只放占位值，严禁写入真实密钥；.env 不进 Git。
# ============================================================================

# ---- 数据库（本地 Docker PostgreSQL）----
# 主机名务必用 127.0.0.1，不要用 localhost：
#   Windows / Docker Desktop 下 localhost 会被优先解析为 IPv6 ::1，而 Docker 只把端口
#   发布在 IPv4 上，Prisma 会卡住 5 秒后报 "Can't reach database server"。
DATABASE_URL="postgresql://taskflow:taskflow@127.0.0.1:5432/taskflow?schema=public"
# 容器内运行时使用（docker-compose.yml 已内置覆盖，裸机开发无需设置）
# DATABASE_URL="postgresql://taskflow:taskflow@db:5432/taskflow?schema=public"

# ---- 认证（Auth.js）----
# 生成方式：openssl rand -base64 32
AUTH_SECRET="replace-me-with-openssl-rand-base64-32"
# 自托管（Docker / 云服务器）下必须为 true，否则 Auth.js 会拒绝非 localhost 的 Host
AUTH_TRUST_HOST="true"
# 仅当请求经过可信反向代理且由代理覆写转发头时设为 true
TRUST_PROXY="false"

# ---- AI（OpenAI-compatible，默认 DeepSeek）----
# 仅服务端可读：严禁添加 NEXT_PUBLIC_ 前缀
# AI_PROVIDER：openai = 调真实模型（需 AI_API_KEY）；mock = 本地预设样本，无需外部依赖
#   本地开发与冒烟建议先留 mock，接好 API Key 后再切 openai
AI_PROVIDER="mock"
AI_BASE_URL="https://api.deepseek.com/v1"
AI_API_KEY=""
AI_MODEL="deepseek-chat"
AI_TIMEOUT_MS="30000"
# 每个用户每分钟允许的 AI 调用次数（滑动窗口）。本地冒烟可调小以复现 429
AI_RATE_LIMIT_PER_MINUTE="10"

# ---- 认证限流（滑动窗口，窗口固定 1 分钟）----
# 同一邮箱每分钟允许的登录**失败**次数：只统计失败，登录成功即清零，
# 因此合法用户不会被自己之前的手误挡住，攻击者也无法靠打满别人的桶把人锁死。
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE="10"
# 同一来源 IP 每分钟允许的登录尝试次数（第二道防线，保护 bcrypt 成本）
# 注意：x-forwarded-for 可伪造，生产必须由 Nginx 覆写：proxy_set_header X-Forwarded-For $remote_addr;
AUTH_IP_RATE_LIMIT_PER_MINUTE="30"
# 同一来源 IP 每分钟允许的注册尝试次数：每次尝试都计数（不退还），因为 bcrypt 落在成功路径上
AUTH_REGISTER_RATE_LIMIT_PER_MINUTE="5"

# ---- PostgreSQL 容器初始化（仅 docker-compose 使用）----
POSTGRES_USER="taskflow"
POSTGRES_PASSWORD="taskflow"
POSTGRES_DB="taskflow"

// TaskFlow 数据模型
// 依据：docs/02-architecture/architecture.md §9、docs/02-architecture/adr-001-technical-decisions.md §5
// 约束：Issue 必须外键绑定 Workspace；状态使用数据库枚举防止非法值入库。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 文档状态（ADR-007 第一阶段：单人写作 MVP，删除为软删除并归档）
enum DocumentStatus {
  DRAFT
  ARCHIVED
}

/// 正文格式：第一阶段只产出 MARKDOWN，RICH_TEXT 为第二阶段预留
enum DocumentContentFormat {
  MARKDOWN
  RICH_TEXT
}

/// Issue 状态：BACKLOG → TODO → IN_PROGRESS → DONE
enum IssueStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  DONE
}

/// 工作区成员角色（架构评审 P1-8）。
/// 用数据库枚举而非裸 String：角色是授权判定依据（文档域的 edit / restore 要求 OWNER 或 EDITOR），
/// 裸字符串允许任意值入库，等同于把一个拼写错误变成「悄无声息的拒绝」。
/// 第一阶段只有 OWNER 与 EDITOR 两种实际取值——没有只读邀请流程，不预先声明未被使用的 MEMBER。
enum WorkspaceRole {
  OWNER
  EDITOR
}

/// 用户：邮箱唯一，密码只存哈希（禁止明文）
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  memberships       WorkspaceMember[]
  ownedWorkspaces   Workspace[]       @relation("WorkspaceOwner")
  authoredDocuments Document[]        @relation("DocumentAuthor")
  documentVersions  DocumentVersion[] @relation("DocumentVersionCreator")
}

/// Auth.js 账号绑定表
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// 会话持久化表。
/// MVP 采用 Auth.js 的 JWT 会话策略（Credentials Provider 的硬性约束），该表不会被写入，
/// 保留它是为了后续接入 OAuth Provider 或实现「登出所有设备」时无需改 Schema。见 adr-001 §4。
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// 数据的隔离单元：所有 Issue / Document 查询的强制过滤维度
model Workspace {
  id        String   @id @default(cuid())
  name      String
  /// 创建者。**仅作展示与审计，不参与权限判定**——判定一律以 WorkspaceMember 为准（架构评审 P1-9）。
  /// 两处都表达「归属」是历史产物；将来实现所有权移交时必须同步更新本字段与成员表，
  /// 否则会出现「ownerId 说 A、成员表说 B」而判定只看后者的漂移。
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner     User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   WorkspaceMember[]
  issues    Issue[]
  documents Document[]

  @@index([ownerId])
}

/// 成员关系：**权限判定的唯一依据**
model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  /// 角色。第一阶段判定规则：read 只要求成员身份；edit / restore 要求 OWNER 或 EDITOR
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

/// 任务。workspaceId 外键必填；title 非空且 ≤200（数据库层用 VarChar(200) 兜底，应用层由 Zod 校验）
model Issue {
  id          String      @id @default(cuid())
  workspaceId String
  title       String      @db.VarChar(200)
  description String?     @db.Text
  status      IssueStatus @default(BACKLOG)
  /// 看板列内排序；步长 100 给未来的无拖拽插入留中缝，历史数据由 createdAt 兜底
  position    Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// 看板分列查询 + 列内按 position 排序
  @@index([workspaceId, status, position])
  /// 列表视图按创建时间排序
  @@index([workspaceId, createdAt])
}

/// 第一阶段不支持用户删除；作者关系使用 Restrict 保护历史归属。
model Document {
  id             String                @id @default(cuid())
  workspaceId    String
  authorId       String
  title          String                @db.VarChar(200)
  content        String                @db.Text
  summary        String?               @db.Text
  format         DocumentContentFormat @default(MARKDOWN)
  status         DocumentStatus        @default(DRAFT)
  contentVersion Int                   @default(1)
  deletedAt      DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    User              @relation("DocumentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  versions  DocumentVersion[]

  @@index([workspaceId, updatedAt, id])
  @@index([authorId, updatedAt])
  @@index([workspaceId, status, updatedAt])
}

model DocumentVersion {
  id          String                @id @default(cuid())
  documentId  String
  version     Int
  title       String                @db.VarChar(200)
  content     String                @db.Text
  summary     String?               @db.Text
  format      DocumentContentFormat
  createdById String
  createdAt   DateTime              @default(now())

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy User     @relation("DocumentVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([documentId, version])
}

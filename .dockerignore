# 构建上下文排除项
# 关键：宿主机 node_modules 是 Windows 产物，必须排除，否则会覆盖镜像内的 Linux 依赖；
#       .env 含真实密钥，绝不能进入镜像（运行时由 compose 的 env_file 注入）。

node_modules
.next
.next-*
out
build
coverage

.git
.gitignore
.github
.vscode
.idea

# 真实密钥与本地配置
.env
.env.*
!.env.example

# 容器与本地工具配置（镜像不需要）
Dockerfile
docker-compose.yml
docker-compose.*.yml
.dockerignore
.prettierignore
.prettierrc.json

# 文档与工作区数据
docs
*.md
.workbuddy
